# =============================================================================
# Template konfigurasi environment — SALIN ke .env.local lalu isi nilainya.
#
#   cp .env.example .env.local
#
# .env.local TIDAK PERNAH di-commit (sudah di-ignore .gitignore).
# Jangan menaruh kredensial asli di file mana pun yang ikut di-commit.
#
# Nilai diambil dari: Firebase Console > Project Settings > General > Your apps
# (Web app > SDK setup and configuration)
# =============================================================================

# Wajib. Tanpa tiga nilai ini, Firebase tidak diinisialisasi dan guestbook
# pada mode "offline" (Situs tetap jalan normal, tanpa data real-time).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opsional. Token debug App Check (reCAPTCHA v3) untuk development.
# Kosongkan di produksi.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Metadata situs (dipakai CLI `wick env` dan footer build).
VITE_SITE_URL=https://dwiki-portfolio.vercel.app
VITE_CONTACT_EMAIL=

# Catatan keamanan:
# - Prefix VITE_ membuat nilai terbaca di bundle browser. Jangan pernah
#   mengisi private key, service account, atau admin SDK di sini.
# - Keamanan Firestore dijaga Rules (src/lib/firestore.rules), bukan env.
