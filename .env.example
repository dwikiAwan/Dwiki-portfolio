VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_SITE_URL=https://dwiki-port.vercel.app
VITE_CONTACT_EMAIL=

# JANGAN PERNAH diisi di Vercel (Production/Preview).
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN melewati App Check, jadi kalau bocor ke
# bundle browser siapa pun bisa memalsukan identitas aplikasi.
# Hanya untuk .env.local saat dev.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# reCAPTCHA v3 site key (Firebase console > App Check > reCAPTCHA v3).
# Tidak secret: aman di browser. Kosongkan berarti App Check tidak aktif.
VITE_RECAPTCHA_SITE_KEY=